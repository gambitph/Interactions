    "gutenbergExample": "<!-- wp:group {\"align\":\"full\",\"layout\":{\"type\":\"constrained\"}} -->\r\n<div class=\"wp-block-group alignfull\"><!-- wp:columns {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\"}}}} -->\r\n<div class=\"wp-block-columns alignfull\" style=\"padding-right:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\"><!-- wp:column {\"width\":\"50%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:heading {\"level\":1,\"style\":{\"color\":{\"text\":\"#000069\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#000069\"}}}},\"fontSize\":\"xx-large\"} -->\r\n<h1 class=\"wp-block-heading has-text-color has-link-color has-xx-large-font-size\" style=\"color:#000069\"><strong>Make Any Website Interactive&nbsp;with the<br>WordPress Editor</strong></h1>\r\n<!-- /wp:heading -->\r\n\r\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#000069\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#000069\"}}}},\"fontSize\":\"large\"} -->\r\n<p class=\"has-text-color has-link-color has-large-font-size\" style=\"color:#000069\">Interactions goes beyond animations,<br>offering versatile trigger and action capabilities.</p>\r\n<!-- /wp:paragraph -->\r\n\r\n<!-- wp:buttons -->\r\n<div class=\"wp-block-buttons\"><!-- wp:button {\"style\":{\"border\":{\"radius\":\"13px\"},\"color\":{\"background\":\"#ff0055\"}}} -->\r\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link has-background wp-element-button\" style=\"border-radius:13px;background-color:#ff0055\">Learn More</a></div>\r\n<!-- /wp:button --></div>\r\n<!-- /wp:buttons --></div>\r\n<!-- /wp:column -->\r\n\r\n<!-- wp:column {\"width\":\"50%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:video -->\r\n<figure class=\"wp-block-video\"><video autoplay loop muted src=\"https://videos.pexels.com/video-files/1572321/1572321-uhd_2560_1440_24fps.mp4\"></video></figure>\r\n<!-- /wp:video --></div>\r\n<!-- /wp:column --></div>\r\n<!-- /wp:columns -->\r\n\r\n<!-- wp:spacer {\"height\":\"300px\"} -->\r\n<div style=\"height:300px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\r\n<!-- /wp:spacer -->\r\n\r\n<!-- wp:columns {\"align\":\"full\",\"style\":{\"spacing\":{\"padding\":{\"right\":\"var:preset|spacing|50\",\"left\":\"var:preset|spacing|50\"}}}} -->\r\n<div class=\"wp-block-columns alignfull\" style=\"padding-right:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)\"><!-- wp:column {\"width\":\"50%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis:50%\"><!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#000069\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#000069\"}}}},\"fontSize\":\"medium\"} -->\r\n<p class=\"has-text-color has-link-color has-medium-font-size\" style=\"color:#000069\"><strong>How it Works</strong></p>\r\n<!-- /wp:paragraph -->\r\n\r\n<!-- wp:heading {\"level\":1,\"style\":{\"color\":{\"text\":\"#000069\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#000069\"}}}},\"fontSize\":\"xx-large\"} -->\r\n<h1 class=\"wp-block-heading has-text-color has-link-color has-xx-large-font-size\" style=\"color:#000069\"><strong>With one&nbsp;trigger, you can set off a&nbsp;series of actions&nbsp;that you can play</strong></h1>\r\n<!-- /wp:heading -->\r\n\r\n<!-- wp:paragraph {\"style\":{\"color\":{\"text\":\"#000069\"},\"elements\":{\"link\":{\"color\":{\"text\":\"#000069\"}}}},\"fontSize\":\"medium\"} -->\r\n<p class=\"has-text-color has-link-color has-medium-font-size\" style=\"color:#000069\"><strong>A trigger can be a click, hover, page scroll, page state, etc; and then you can build a timeline of actions like fade, move, scroll, update post meta data, call webhooks, and more. Combine and build experiences.</strong></p>\r\n<!-- /wp:paragraph --></div>\r\n<!-- /wp:column -->\r\n\r\n<!-- wp:column {\"width\":\"25%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis:25%\"><!-- wp:image {\"sizeSlug\":\"large\",\"style\":{\"border\":{\"radius\":\"12px\"}}} -->\r\n<figure class=\"wp-block-image size-large has-custom-border\"><img src=\"https://images.unsplash.com/photo-1484821582734-6c6c9f99a672?q=80&amp;w=1933&amp;auto=format&amp;fit=crop&amp;ixlib=rb-4.1.0&amp;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"\" style=\"border-radius:12px\"/></figure>\r\n<!-- /wp:image --></div>\r\n<!-- /wp:column -->\r\n\r\n<!-- wp:column {\"width\":\"25%\"} -->\r\n<div class=\"wp-block-column\" style=\"flex-basis:25%\"><!-- wp:image {\"sizeSlug\":\"large\",\"style\":{\"border\":{\"radius\":\"12px\"}}} -->\r\n<figure class=\"wp-block-image size-large has-custom-border\"><img src=\"https://images.unsplash.com/photo-1484821582734-6c6c9f99a672?q=80&amp;w=1933&amp;auto=format&amp;fit=crop&amp;ixlib=rb-4.1.0&amp;ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D\" alt=\"\" style=\"border-radius:12px\"/></figure>\r\n<!-- /wp:image --></div>\r\n<!-- /wp:column --></div>\r\n<!-- /wp:columns --></div>\r\n<!-- /wp:group -->",
