{
    "id": "imageBlur",
    "name": "Image Blur",
    "description": "Removes the blur to see the image clearly",
    "category": "image",
    "apply": {
        "name": "Image Blur Effect",
        "category": "hover"
    },
    "preview": "imageBlur",
    "interactionSetup": {
        "type": "hover",
        "timelines": [
            {
                "loop": false,
                "onceOnly": false,
                "alternate": false,
                "reset": false,
                "reverse": false,
                "actions": [
                    {
                        "type": "cssRule",
                        "target": {
                            "type": "trigger",
                            "value": "",
                            "blockName": "",
                            "options": ""
                        },
                        "timing": {
                            "isStartingState": true,
                            "start": -1,
                            "duration": 0.5,
                            "easing": "outCirc",
                            "customEasing": ""
                        },
                        "value": {
                            "property": "filter",
                            "value": "blur(3px)"
                        }
                    },
                    {
                        "type": "cssRule",
                        "target": {
                            "type": "trigger",
                            "value": "",
                            "blockName": "",
                            "options": ""
                        },
                        "timing": {
                            "isStartingState": false,
                            "start": 0,
                            "duration": 0.3,
                            "easing": "outCirc",
                            "customEasing": ""
                        },
                        "value": {
                            "property": "filter",
                            "value": "blur(0px)"
                        }
                    }
                ]
            },
            {
                "loop": false,
                "onceOnly": false,
                "alternate": false,
                "reset": false,
                "reverse": false,
                "actions": [
                    {
                        "type": "cssRule",
                        "target": {
                            "type": "trigger",
                            "value": "",
                            "blockName": "",
                            "options": ""
                        },
                        "timing": {
                            "isStartingState": false,
                            "start": 0,
                            "duration": 0.3,
                            "easing": "outCirc",
                            "customEasing": ""
                        },
                        "value": {
                            "property": "filter",
                            "value": "blur(3px)"
                        }
                    }
                ]
            }
        ],
        "options": []
    },
    "configurableOptions": [
        {
            "key": "interactionType",
            "controls": {
                "name": "Interaction Type",
                "type": "select",
                "help": "Choose the interaction type that triggers the blur effect.",
                "options": [
                    {
                        "value": "click",
                        "label": "Click"
                    },
                    {
                        "value": "hover",
                        "label": "Hover"
                    },
                    {
                        "value": "enterViewport",
                        "label": "Entered into viewport"
                    }
                ],
                "default": "hover"
            },
            "mappings": [
                {
                    "path": [
                        "type"
                    ]
                }
            ]
        },
        {
            "key": "duration",
            "controls": {
                "name": "Duration",
                "type": "number",
                "help": "Adjust the animation duration in seconds.",
                "min": 0,
                "max": 5,
                "step": 0.1,
                "default": 0.3
            },
            "mappings": [
                {
                    "path": [
                        "timelines",
                        0,
                        "actions",
                        1,
                        "timing",
                        "duration"
                    ]
                }
            ]
        }
    ],
    "applyWhitelist": [
        "\\bimage\\b"
    ],
